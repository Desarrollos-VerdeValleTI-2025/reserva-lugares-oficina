# Puerto en el que escucha el servidor
PORT=4000

# Ambiente: development | qas | production
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma (sin espacios)
ORIGENES_PERMITIDOS=http://localhost:5173

# Conexión a MySQL (Actividad 3 — base de datos reservalugares)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reservalugares
DB_USER=app_reservas_api
DB_PASSWORD=

# Azure AD / MSAL — validación del token en el backend (Actividad 4)
# Se llenan con los valores reales del App Registration cuando los tengas.
# El emisor (issuer) se arma en código a partir del tenant id, no hace falta declararlo aparte.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
