# URL base del API (backend), incluyendo el prefijo /api
VITE_API_URL=http://localhost:4000/api

# Azure AD / MSAL — App Registration del FRONT (login)
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173

# Scope del API (App Registration DISTINTO al del front)
VITE_AZURE_AD_API_SCOPE=api://<client-id-del-api>/API.Access
